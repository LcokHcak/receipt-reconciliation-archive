# 这是 2c4g 小机器的样板 .env。
# 把它 cp 到 .env 后改两个必填项就能跑。
#
# 跟 .env.example 的区别：
#   - PYTHON_PROCESS_POOL_MAX 从 5 降到 1（每个 worker 占 2-3GB，4GB 机器只能起 1 个）
#   - PADDLE_BATCH_CHUNK_SIZE 从 5 降到 2（一次少处理几张图，避免内存抖动）
#   - SIGNATURE_WORKER_CONCURRENCY 改 1
#   - 启用 SIGN_ENABLE_MODEL_PIPELINE，但是路径要按 Linux 改
#
# OCR 在这个配置下会"慢但能跑"：
#   - 单张护照识别约 3-6 秒（本地工作站约 0.5-1 秒）
#   - 一次 100 张图批量约 5-10 分钟（本地约 1-2 分钟）
#   - 用户体验：能用、不会崩、不要求并发

PORT=3000
HOST=127.0.0.1                            # 让 caddy/nginx 反向代理；不要直接暴露 0.0.0.0

# ── Authentication（必填）────────────────────────────
SIGN_ENABLE_AUTH=true
JWT_SECRET=CHANGE_ME_TO_RANDOM_32+_BYTES_e.g._openssl_rand_hex_32
SIGN_BOOTSTRAP_ADMIN_USERNAME=admin
SIGN_BOOTSTRAP_ADMIN_PASSWORD=CHANGE_ME_STRONG_PASSWORD
SIGN_AUTH_COOKIE_SECURE=true              # 走 https 时设 true，纯 IP+http 时改 false

# ── Python pool（关键：2c4g 只能 1 个 worker）─────────
PYTHON_PROCESS_POOL_MIN=1
PYTHON_PROCESS_POOL_MAX=1
PYTHON_PROCESS_IDLE_TIMEOUT=120000        # 空闲 2 分钟才回收，避免反复加载模型

# OCR 批处理一次只塞 2 张
PADDLE_BATCH_CHUNK_SIZE=2
SIGNATURE_WORKER_CONCURRENCY=1

# Base PaddleOCR runtime
# 2c4g Linux 部署复用 /opt/_pdx_runtime；需额外安装 paddleocr==2.9.1。
PADDLE_OCR_PYTHON_EXE=/opt/_pdx_runtime/bin/python3
PADDLE_OCR_TIMEOUT_MS=600000

# ── PaddleX 模型 pipeline ─────────────────────────────
SIGN_ENABLE_MODEL_PIPELINE=true
SIGN_PADDLEX_PYTHON_EXE=/opt/_pdx_runtime/bin/python3
# Linux 路径示例：项目放在 /opt/sign-workbench
SIGN_SPLIT_DET_MODEL_DIR=/opt/sign-workbench/model/mix/model/general_object_detection_module
SIGN_SPLIT_DET_MODEL_NAME=PP-YOLOE_plus-L
SIGN_SPLIT_DET_THRESHOLD=0.55
SIGN_DOC_CLS_MODEL_DIR=/opt/sign-workbench/model/analyse/model/general_image_classification_module
SIGN_DOC_CLS_MODEL_NAME=PP-HGNetV2-B6
SIGN_DOC_CLS_MIN_CONFIDENCE=0.70
SIGN_DOC_CLS_MIN_MARGIN=0.12
SIGN_PASSPORT_FIELD_DET_MODEL_DIR=/opt/sign-workbench/model/passport_find2/model/general_object_detection_module
SIGN_PASSPORT_FIELD_DET_MODEL_NAME=PP-YOLOE_plus-S
SIGN_PASSPORT_FIELD_DET_THRESHOLD=0.30
SIGN_RECEIPT_FIELD_DET_MODEL_DIR=/opt/sign-workbench/model/receipt_find2/model/general_object_detection_module
SIGN_RECEIPT_FIELD_DET_MODEL_NAME=PP-YOLOE_plus-S
SIGN_RECEIPT_FIELD_DET_THRESHOLD=0.30

# ── 备份目标 ──────────────────────────────────────────
SIGN_BACKUP_TARGET=/opt/sign-workbench/backups
SIGN_BACKUP_RETAIN=7

# ── 日志级别（生产建议 info；调试时改 debug）─────────
LOG_LEVEL=info
