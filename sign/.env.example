PORT=3218
PADDLE_BATCH_CHUNK_SIZE=5
SIGNATURE_WORKER_CONCURRENCY=2

# G11e: 服务时区固定为韩国时间,避免跨日审核漂移到错误 daily 桶。
# 服务器是 Asia/Seoul (UTC+9);如果机器物理时区不同,Node 进程内的
# new Date().toLocaleString() / xlsx 时间列都会按这个走。
TZ=Asia/Seoul

