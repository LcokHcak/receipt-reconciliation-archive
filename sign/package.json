{
  "name": "sign",
  "version": "1.0.0",
  "description": "PaddleOCR-based passport and receipt review workbench",
  "main": "passport_review_workbench.js",
  "scripts": {
    "classify:documents": "node scripts/evaluate_document_classification.js",
    "stress:chaos": "node scripts/run_ui_chaos_probe.js",
    "stress:manual": "node scripts/run_manual_stress_200.js",
    "probe:operator": "node scripts/run_operator_regression_probe.js",
    "stress:check": "node --check scripts/run_ui_chaos_probe.js && node --check scripts/run_manual_stress_200.js && node --check scripts/run_vue_smoke_probe.js && node --test tests/run_ui_chaos_probe.test.js tests/vue_smoke_probe.test.js",
    "smoke:vue": "node scripts/run_vue_smoke_probe.js",
    "test:e2e": "node node_modules/@playwright/test/cli.js test",
    "test": "node --test --import=./tests/_stall_watchdog.mjs --test-timeout=300000 tests/*.test.js tests/monthly/*.test.js tests/sprint_b/*.test.js tests/sprint_e/*.test.js tests/sprint_f/*.test.js tests/sprint_g/*.test.js",
    "workbench": "node --env-file=.env passport_review_workbench.js",
    "start:prod": "node --env-file=.env passport_review_workbench.js",
    "backup": "node scripts/backup_sqlite.js",
    "perf:agent-workspace": "node -e \"process.env.RUN_PERF='1';require('node:child_process').execFileSync(process.execPath,['--test','tests/agent_workspace_performance.test.js'],{stdio:'inherit',env:process.env})\"",
    "agent-workspace:rebuild": "node scripts/rebuild_agent_workspace_projection.js",
    "agent-workspace:rebuild:apply": "node scripts/rebuild_agent_workspace_projection.js --apply",
    "backup:verify": "node scripts/backup_sqlite.js --verify",
    "data:archive-batch": "node scripts/archive_test_batch.js",
    "db:migrate": "node scripts/migrate_json_to_sqlite.js",
    "db:check": "node scripts/check_storage_consistency.js",
    "db:restore": "node scripts/restore_from_json.js",
    "users": "node scripts/manage_users.js",
    "docs:api": "node scripts/check_openapi.js",
    "lint": "eslint .",
    "format:check": "prettier . --check"
  },
  "keywords": [],
  "author": "",
  "license": "ISC",
  "engines": {
    "node": ">=22.5.0"
  },
  "type": "commonjs",
  "dependencies": {
    "bcrypt": "^6.0.0",
    "cookie-parser": "^1.4.7",
    "decimal.js": "^10.6.0",
    "dotenv": "^17.4.2",
    "exceljs": "^4.4.0",
    "express": "^5.1.0",
    "generic-pool": "^3.9.0",
    "jsonwebtoken": "^9.0.3",
    "jszip": "^3.10.1",
    "multer": "^2.0.2",
    "pdfkit": "^0.18.0",
    "pino": "^10.3.1",
    "sharp": "^0.34.5",
    "sqlite": "^5.1.1",
    "sqlite3": "^6.0.1",
    "zxing-wasm": "^3.1.2"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@playwright/test": "^1.60.0",
    "eslint": "^10.3.0",
    "eslint-plugin-vue": "^10.9.1",
    "globals": "^17.6.0",
    "pino-pretty": "13.1.3",
    "playwright": "^1.60.0",
    "prettier": "^3.8.3",
    "ssh2": "^1.17.0",
    "vue-eslint-parser": "^10.4.0"
  }
}
