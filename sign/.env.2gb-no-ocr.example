# 2GB 服务器、关 OCR、纯对账测试用 .env
#
# 适用场景：先在小机器上验证业务流程（导入 xlsx → 对账 → 导出）
# OCR 部分继续在本地跑，等机器升到 4GB+ 再开启 PaddleX。
#
# 部署到 /opt/sign-workbench 后：
#   cp .env.2gb-no-ocr.example .env
#   nano .env   # 改 JWT_SECRET 和管理员密码
#   pm2 start ecosystem.2c4g.config.cjs

PORT=3000
HOST=127.0.0.1                            # 本机回环；让外部走 caddy/nginx 反代

# ── 必填：认证（JWT_SECRET 必须设，否则 token 不安全）─────
SIGN_ENABLE_AUTH=true
JWT_SECRET=CHANGE_ME_RUN_openssl_rand_hex_32_TO_GENERATE
SIGN_BOOTSTRAP_ADMIN_USERNAME=admin
SIGN_BOOTSTRAP_ADMIN_PASSWORD=CHANGE_ME_STRONG_PASSWORD
# 走纯 IP+http 时设 false；上 https 后改 true
SIGN_AUTH_COOKIE_SECURE=false

# ── 关键：关掉模型 pipeline（2GB 跑不动 PaddleX）──────────
SIGN_ENABLE_MODEL_PIPELINE=false

# Python pool 也降到 0 - 1，避免 idle worker 吃内存
PYTHON_PROCESS_POOL_MIN=0
PYTHON_PROCESS_POOL_MAX=1
PYTHON_PROCESS_IDLE_TIMEOUT=30000

PADDLE_BATCH_CHUNK_SIZE=1
SIGNATURE_WORKER_CONCURRENCY=1

# ── 备份 ─────────────────────────────────────────────────
SIGN_BACKUP_TARGET=/opt/sign-workbench/backups
SIGN_BACKUP_RETAIN=3                      # 2GB 机器盘紧，备份只留 3 份

LOG_LEVEL=info
